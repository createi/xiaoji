{
  "name": "@xiaoji/prisma",
  "version": "0.1.0",
  "private": true,
  "description": "xiaoji Prisma Schema 和数据库管理",
  "scripts": {
    "generate": "pnpm exec prisma generate",
    "migrate:dev": "pnpm exec prisma migrate dev",
